{
  "name": "gts-monorepo",
  "private": true,
  "workspaces": [
    "GTS_landingpage",
    "GTS_app/frontend",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "npm --workspace=GTS_landingpage run dev",
    "dev:app": "npm --workspace=GTS_app/frontend run dev",
    "dev": "concurrently -k -c \"green,magenta\" -n \"LANDING,APP\" \"npm run dev:landing\" \"npm run dev:app\"",
    "prod:up": "docker compose -f docker-compose.yaml up -d --build"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.7",
    "@types/nodemailer": "^6.4.17"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  }
}
